# Postgres connection used by the app (dev/prod). Port 5433 (not 5432) to
# avoid colliding with a native Postgres install some machines already have
# running on 5432 — see docker-compose.yml.
DATABASE_URL="postgresql://holdline:holdline@localhost:5433/holdline?schema=public"

# Separate database used by `npm run test:integration` — never point this at dev/prod data,
# the integration suite truncates tables between tests.
TEST_DATABASE_URL="postgresql://holdline:holdline@localhost:5433/holdline_test?schema=public"

NODE_ENV="development"
PORT=3000

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# CORS
CORS_ORIGIN="http://localhost:5173"

# Payments — unused while PAYMENT_PROVIDER=simulated, wired for a future Stripe swap-in
PAYMENT_PROVIDER="simulated"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
