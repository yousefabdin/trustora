# Config for docker-compose.stack.yml — the fully dockerized app+Postgres
# stack. Used both locally (`npm run docker:stack:up`, which passes
# --env-file env/stack.env) and by the `docker` job's smoke-test step in
# .github/workflows/ci.yml. These are non-production placeholder values —
# fine to commit, never used against a real deployment.
#
# For a real QA/prod deployment, do NOT reuse this file: supply real secrets
# via GitHub Environment secrets or the host's own secret manager, following
# the shape of env/qa.secrets.env.example / env/prod.secrets.env.example.

NODE_ENV=production
APP_PORT=3000

POSTGRES_USER=holdline
POSTGRES_PASSWORD=stack-local-postgres-password
POSTGRES_DB=holdline

JWT_ACCESS_SECRET=stack-local-access-secret-not-for-production-32ch
JWT_REFRESH_SECRET=stack-local-refresh-secret-not-for-production-32ch
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGIN=http://localhost:5173
PAYMENT_PROVIDER=simulated
