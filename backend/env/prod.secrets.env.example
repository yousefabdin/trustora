# Template only — DO NOT fill in real values and commit this file.
#
# Once a real prod host exists, supply these as GitHub Environment secrets
# (Settings > Environments > prod) or via that host's own secret manager, and
# reference them in a deploy job's `env:` — never as a committed file. See
# env/prod.env for the non-secret config that DOES ship in this repo.
#
# If you do create a local env/prod.secrets.env for testing, .gitignore
# already excludes it from being committed.

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
DATABASE_URL=
POSTGRES_PASSWORD=
