# Non-secret QA environment config, loaded by the `docker` job in
# .github/workflows/ci.yml on pushes to `develop`. Drives both the published
# image tags and (once a real QA host exists) the app's own runtime config.
# Real secrets never go in this file — see env/qa.secrets.env.example.

ENV_TAG=qa
ALIAS_TAG=develop

NODE_ENV=production
CORS_ORIGIN=https://qa.holdline.example.com
PAYMENT_PROVIDER=simulated
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
