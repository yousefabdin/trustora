# Non-secret prod environment config, loaded by the `docker` job in
# .github/workflows/ci.yml on pushes to `master`. Drives both the published
# image tags and (once a real prod host exists) the app's own runtime config.
# Real secrets never go in this file — see env/prod.secrets.env.example.

ENV_TAG=prod
ALIAS_TAG=latest

NODE_ENV=production
CORS_ORIGIN=https://holdline.example.com
PAYMENT_PROVIDER=simulated
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
