# Loaded by the `verify` job in .github/workflows/ci.yml via $GITHUB_ENV.
# These are throwaway values scoped to an ephemeral GitHub Actions runner —
# never used against a real database or a real deployment, safe to commit.
#
# NOTE: services.postgres.env in ci.yml duplicates POSTGRES_USER/PASSWORD/DB
# as literals rather than reading this file. GitHub Actions starts service
# containers before any step (including checkout) runs, so the `services:`
# block cannot read repo files — only `${{ secrets.* }}` / `${{ vars.* }}`
# expressions or literals are available there. If you change the Postgres
# credentials below, update ci.yml's `services.postgres.env` to match.

NODE_ENV=test
DATABASE_URL=postgresql://holdline:holdline@localhost:5432/holdline?schema=public
TEST_DATABASE_URL=postgresql://holdline:holdline@localhost:5432/holdline_test?schema=public

POSTGRES_USER=holdline
POSTGRES_PASSWORD=holdline
POSTGRES_DB=holdline
TEST_POSTGRES_DB=holdline_test

JWT_ACCESS_SECRET=ci-access-secret-not-for-production-use-32ch
JWT_REFRESH_SECRET=ci-refresh-secret-not-for-production-use-32ch
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGIN=http://localhost:5173
PAYMENT_PROVIDER=simulated
